# Copy to .env and fill in. You need the key for whichever provider you use.
ANTHROPIC_API_KEY=sk-ant-...

# Provider: "anthropic" (default) or "openai". Switch when low on credits — then you
# need OPENAI_API_KEY instead of ANTHROPIC_API_KEY.
# RADAR_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# RADAR_OPENAI_MODEL=gpt-4o

# Optional overrides (defaults live in config.py)
# RADAR_MODEL=claude-opus-4-8
# RADAR_INTERESTS=AI agents,developer tooling,automation,APIs
# RADAR_MAX_PER_SOURCE=25
# RADAR_DEDUP_DAYS=7              # don't resurface a problem within N days
# RADAR_GITHUB_RECENCY_DAYS=30   # only pull GitHub issues created in the last N days

# Optional: GitHub Issues runs without a token, but a free PAT raises the rate limit
# and avoids 403s. Create one (no scopes needed for public read) at
# https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_...

# Optional: email the brief after each run via Resend (https://resend.com).
# Free tier needs no domain — EMAIL_TO must be your Resend signup address.
# RESEND_API_KEY=re_...
# EMAIL_TO=you@example.com
# EMAIL_FROM=Problembrief <onboarding@resend.dev>   # default; change once you verify a domain
