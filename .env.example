# Copy to .env and fill in. Only the API key is required for V1.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults live in config.py)
# RADAR_MODEL=claude-opus-4-8
# RADAR_SUBREDDITS=devtools,programming,SaaS,startups,ExperiencedDevs,LocalLLaMA
# RADAR_INTERESTS=AI agents,developer tooling,automation,APIs
# RADAR_MAX_PER_SOURCE=25

# Optional: enable Reddit. Without these, Reddit is skipped (HN + Lobsters still run).
# Create an app at https://www.reddit.com/prefs/apps (type: "script"), then:
# REDDIT_CLIENT_ID=your_client_id
# REDDIT_CLIENT_SECRET=your_client_secret
